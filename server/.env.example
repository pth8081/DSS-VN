# Copy file này thành .env rồi điền thông tin thật, KHÔNG commit file .env

# --- Bắt buộc để server khởi động được ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DSS_VN
DB_USER=sa
DB_PASSWORD=
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-chay-that

# --- Tùy chọn ---
PORT=3000
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
UPLOAD_MAX_MB=20

# --- API kế toán ngoài (Module 8 — chỉ cần nếu dùng endpoint xác nhận thanh
# toán POST /api/external/payment-confirmations; bỏ trống thì endpoint tự trả
# 503, không ảnh hưởng phần còn lại của hệ thống) ---
ACCOUNTING_API_KEY=
# Danh sách IP được phép gọi, cách nhau bởi dấu phẩy — để trống = không giới hạn IP
ACCOUNTING_API_IP_ALLOWLIST=
